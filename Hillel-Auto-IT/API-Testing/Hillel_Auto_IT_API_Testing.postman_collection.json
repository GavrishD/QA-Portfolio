          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "",
              "pm.test(\"Create user request handled correctly\", function () {",
              "    pm.expect([201, 400]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test(\"Response status is valid\", function () {",
              "    pm.expect(jsonData.status).to.be.oneOf([\"ok\", \"error\"]);",
              "});",
              "",
              "if (jsonData.status === \"ok\") {",
              "    pm.environment.set(\"userId\", jsonData.data.userId);",
              "",
              "    pm.test(\"User ID is returned\", function () {",
              "        pm.expect(jsonData.data.userId).to.exist;",
              "    });",
              "}",
              "",
              "if (jsonData.status === \"error\") {",
              "    pm.test(\"User already exists message returned\", function () {",
              "        pm.expect(jsonData.message).to.eql(\"User already exists\");",
              "    });",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
